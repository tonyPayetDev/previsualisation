<script>
jQuery(document).ready(function( $ ){
    $('.felixtransports-quick-form-content #child_seat, .felixtransports-quick-form-content #back_forth').on('click', function() {
		
	  	var departure_city = $('#departure_city').find(":selected").val();
		var arrival_city = $('#arrival_city').find(":selected").val();
		//var date_time = $('#date_time').val(); 
		var product_id = $('#booking_product_id').val(); 
		
		if(departure_city=='' || arrival_city==''){
			return false;
		}
		
		var child_seat = false;
		if($('#child_seat').is(':checked')){
			child_seat = true;
		}
		var back_forth = false;
		if($('#back_forth').is(':checked')){
			back_forth = true;
		}
		
		if($('.variation_id').length && $('.variation_id').val().length){
			var variation_id = $('.variation_id').val();
		}else{
			var variation_id = '';
		}
		
		
		// https://felixtransports.re/wp-admin/admin-ajax.php?action=get_transport_price&departure_city=36&arrival_city=33&date_time=2025/02/01%2012:00&product_id=23
		
		$.ajax({
             type : "POST",
             dataType : "json",
             url : "/wp-admin/admin-ajax.php",
             data : {action: "get_direct_buy", departure_city: departure_city, arrival_city : arrival_city, product_id: product_id, variation_id: variation_id, child_seat: child_seat, back_forth: back_forth},
             success: function(response) {
					
				 	$('.felixtransports-quick-form-content .price-label span').html(response.data);
                   	console.log(response);
			 },
			 'error' : function(request,error) {
                        alert("Error in response: "+JSON.stringify(error));
              }	
        }); 
		
	});
	
   	$('.felixtransports-quick-form-content #departure_city, .felixtransports-quick-form-content #arrival_city').on('change', function() {
		
	  	var departure_city = $('#departure_city').find(":selected").val();
		var arrival_city = $('#arrival_city').find(":selected").val();
		//var date_time = $('#date_time').val(); 
		var product_id = $('#booking_product_id').val(); 
		
		if(departure_city=='' || arrival_city==''){
			return true;
		}
		
		var child_seat = false;
		if($('#child_seat').is(':checked')){
			child_seat = true;
		}
		var back_forth = false;
		if($('#back_forth').is(':checked')){
			back_forth = true;
		}
		
		if($('.variation_id').length && $('.variation_id').val().length){
			var variation_id = $('.variation_id').val(); 
		}else{
			var variation_id = ''; 
		}
		
		
		// https://felixtransports.re/wp-admin/admin-ajax.php?action=get_transport_price&departure_city=36&arrival_city=33&date_time=2025/02/01%2012:00&product_id=23
		console.log({action: "get_direct_buy", departure_city: departure_city, arrival_city : arrival_city, product_id: product_id, variation_id: variation_id, child_seat: child_seat, back_forth: back_forth});
		$.ajax({
             type : "POST",
             dataType : "json",
             url : "/wp-admin/admin-ajax.php",
             data : {action: "get_direct_buy", departure_city: departure_city, arrival_city : arrival_city, product_id: product_id, variation_id: variation_id, child_seat: child_seat, back_forth: back_forth},
             success: function(response) {
					
				 	$('.felixtransports-quick-form-content .price-label span').html(response.data);
                   	console.log(response);
			 },
			 'error' : function(request,error) {
                        alert("Error in response: "+JSON.stringify(error));
              }	
        }); 
			
			
		
	});
});</script>
<!-- end Simple Custom CSS and JS -->
