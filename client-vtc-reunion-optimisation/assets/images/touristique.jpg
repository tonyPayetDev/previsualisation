jQuery(document).ready(function( $ ){
   	$(".felixtransports-quote-form").submit(function(e) {

        //prevent Default functionality
        e.preventDefault();
		
		var form_data = $(this).serialize();

        //get the action-url of the form
        var actionurl = e.currentTarget.action;
		$("#quote_now").attr("disabled", true);
        //do your own request an handle the results
		
		// https://felixtransports.re/wp-admin/admin-ajax.php?action=quote-form-submit&departure_city=36&arrival_city=33&date_time=2025/02/01%2012:00&booking_product_id=23&full_name=pratt&phone_no=9877&email_id=priynlar.seo@gmail.com"e=test
		
        $.ajax({
                url: '/wp-admin/admin-ajax.php',
                type: 'POST',
                dataType: 'json',
                data: form_data,
                success: function(response) {
                    $('.quote-form-response').html(response.data);
					$('.felixtransports-quote-form')[0].reset();
					$("#quote_now").removeAttr("disabled");
                }
        });

    });
});</script>
